{
  "_comment": "Self-play pilot (grid.json runs 1-6 at pilot scale): the same settings as pilot.json, except that the current policy plays both seats of every match and both seats are trained on, so each step trains on twice as many replies. Checkpoints every 10 steps (and on Ctrl-c). Every 10 steps, and at the last step, 32 matches against never_fold (fixed seeds) measure progress, because self-play win rates are about 0.5 by construction.",
  "defaults": {
    "game": "SpiralKuhnPoker-v1",
    "opponent": "self",
    "steps": 30,
    "matches_per_step": 8,
    "max_new_tokens": 512,
    "max_train_len": 2048,
    "generation_batch_size": 16,
    "mini_batch_size": 2,
    "learning_rate": 1e-04,
    "gradient_clipping": 0.2,
    "temperature": 0.6,
    "top_p": 0.95,
    "rae_tau": 0.001,
    "format_reward": 1.5,
    "valid_move_reward": 1.0,
    "invalid_move_penalty": -1.0,
    "lora": {"lora_rank": 32, "lora_alpha": 32, "lora_dropout": 0.0,
             "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]},
    "save_every": 10,
    "eval_opponent": "never_fold",
    "eval_matches": 32,
    "eval_every": 10
  },
  "runs": [
    {"run_id": "selfplay_qwen3-1.7b_rae_s0", "model": "Qwen/Qwen3-1.7B-Base", "estimator": "rae", "seed": 0},
    {"run_id": "selfplay_qwen3-1.7b_shared_s0", "model": "Qwen/Qwen3-1.7B-Base", "estimator": "shared", "seed": 0},
    {"run_id": "selfplay_qwen3-1.7b_rae_s1", "model": "Qwen/Qwen3-1.7B-Base", "estimator": "rae", "seed": 1},
    {"run_id": "selfplay_qwen3-1.7b_shared_s1", "model": "Qwen/Qwen3-1.7B-Base", "estimator": "shared", "seed": 1},
    {"run_id": "selfplay_qwen3-1.7b_rae_s2", "model": "Qwen/Qwen3-1.7B-Base", "estimator": "rae", "seed": 2},
    {"run_id": "selfplay_qwen3-1.7b_shared_s2", "model": "Qwen/Qwen3-1.7B-Base", "estimator": "shared", "seed": 2}
  ]
}
